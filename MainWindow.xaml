<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="YTMHub.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:YTMHub"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Title="YTM Hub"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="CustomTitleBar" Grid.Row="0" Background="Transparent">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            
            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,12,0">
                <Image Source="Assets/AppIcon.ico" Width="16" Height="16" Margin="0,0,12,0" />
                <TextBlock Text="YTM Hub" VerticalAlignment="Center" FontSize="12" />
            </StackPanel>

            <!-- This empty border is what the user drags to move the window -->
            <Border x:Name="AppDragRegion" Grid.Column="1" Background="Transparent" />

            <!-- The toggle switch is safely outside the drag region, so it's clickable! -->
            <!-- Flyout for Remote Server -->
            <Button Grid.Column="2" VerticalAlignment="Center" Margin="0,0,150,0" Background="Transparent" BorderThickness="0" ToolTipService.ToolTip="Remote Server">
                <Button.Content>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Remote" FontSize="12" VerticalAlignment="Center"/>
                        <FontIcon FontFamily="Segoe Fluent Icons" Glyph="&#xED14;" FontSize="16" />
                    </StackPanel>
                </Button.Content>
                <Button.Flyout>
                    <Flyout Opened="RemoteFlyout_Opened">
                        <StackPanel Spacing="10" Width="220">
                            <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                                <TextBlock Text="Remote Server" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,0,2"/>
                                <ToggleSwitch x:Name="ServerToggle" Header="{x:Null}" OffContent="{x:Null}" OnContent="{x:Null}" VerticalAlignment="Center" Margin="0" MinWidth="0" Padding="0" Toggled="ServerToggle_Toggled" IsTabStop="False" />
                            </StackPanel>
                            <StackPanel x:Name="QrCodePanel" Visibility="Collapsed" Spacing="10">
                                <Border Background="White" Padding="10" CornerRadius="8" HorizontalAlignment="Center">
                                    <Image x:Name="QrCodeImage" Width="150" Height="150" />
                                </Border>
                                <TextBlock x:Name="ServerUrlText" TextAlignment="Center" Foreground="Gray" FontSize="12" IsTextSelectionEnabled="True" />
                            </StackPanel>
                        </StackPanel>
                    </Flyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <Grid Grid.Row="1">
            <WebView2 x:Name="MainWebView" Source="https://music.youtube.com" />
        </Grid>
    </Grid>
</Window>
